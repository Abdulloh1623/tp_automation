# TP Automation — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.

# --- PostgreSQL ---
# LOKAL ishlab chiqish (Docker tp-postgres, port 5433):
#   DATABASE_URL="postgresql://tp:PAROL@localhost:5433/tp_automation?schema=public"
# DOCKER COMPOSE (prod) — host = `postgres` xizmat nomi, port 5432:
# Kichik serverda (t3.small) app+worker postgres ulanishlarini bosib ketmasligi
# uchun `connection_limit` qo'shish tavsiya etiladi (Prisma pool cheklovi):
#   ...tp_automation?schema=public&connection_limit=5
DATABASE_URL="postgresql://tp:PAROL@postgres:5432/tp_automation?schema=public&connection_limit=5"

# docker-compose postgres xizmati shu qiymatlardan foydalanadi (DATABASE_URL bilan mos bo'lsin):
POSTGRES_USER="tp"
POSTGRES_PASSWORD="PAROL"
POSTGRES_DB="tp_automation"

# Birinchi ADMIN'ni yaratish uchun (npm run create-admin) — deploydan keyin bir marta:
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# Session JWT maxfiy kaliti — KUCHLI tasodifiy qiymat qo'ying.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=""

# --- Domen / HTTPS (Caddy) ---
# Sayt domeni — A-record Elastic IP ga yo'naltirilган bo'lsin. Caddy shu domenга
# avtomatik Let's Encrypt sertifikat oladi. Masalan: DOMAIN="crm.example.uz"
DOMAIN=""
# Ixtiyoriy: COOKIE_SECURE odatda kerak emas (x-forwarded-proto orqali aniqlanadi).

# Telegram bot (Faza 7) — BotFather'dan olingan token (maxfiy)
TELEGRAM_BOT_TOKEN=""
# Kanal IDsi: -100... yoki @kanal_nomi (bo'sh bo'lsa hisobotlar log rejimida)
TELEGRAM_CHANNEL_ID=""
# To'lovlar kanali (chek + mijoz ma'lumoti); bo'sh bo'lsa log rejimi
TELEGRAM_PAYMENTS_CHANNEL_ID=""
# Backup (zaxira) kanali — kunlik DB nusxasi yuboriladi; bo'sh bo'lsa skip
TELEGRAM_BACKUP_CHANNEL_ID=""
# Xato (error) kanali — server/worker xatolari avtomatik yuboriladi.
# Bo'sh bo'lsa backup → asosiy kanalga tushadi; ular ham bo'lmasa faqat konsolga.
TELEGRAM_ERRORS_CHANNEL_ID=""
# "To'lov cheklari" GURUHI — bot shu yerdan chek rasm/PDF larini o'qib,
# /tolovlar sahifasidagi tasdiqlash navbatiga qo'yadi. Bo'sh bo'lsa qabul
# qilish o'chiq. Guruh IDsi -100... ko'rinishida; bot guruhda ADMIN bo'lishi
# kerak (aks holda privacy rejimi tufayli xabarlarni ko'rmaydi).
TELEGRAM_RECEIPTS_GROUP_ID=""

# --- Backup shifrlash (tavsiya etiladi) ---
# Telegramga yuboriladigan DB nusxasi shu parol-ibora bilan AES-256-GCM
# shifrlanadi (lokal nusxa shifrlanmaydi — u serverning o'zida turadi).
# Bo'sh qoldirilsa dump SHIFRLANMAGAN ketadi va caption'da ogohlantirish
# yoziladi. Kamida 12 belgi.
#
# MUHIM: bu qiymatni serverdagi .env da SAQLAMANG — aks holda serverga kirgan
# hujumchi ham dump'ni, ham kalitni oladi. Parol menejerida saqlang va faqat
# ochish paytida bering:
#   BACKUP_ENCRYPTION_KEY='...' npx tsx scripts/decrypt-backup.ts fayl.enc
BACKUP_ENCRYPTION_KEY=""

# --- Reverse proxy ---
# Ilova oldidagi ISHONCHLI proksilar soni (Caddy = 1). Login rate-limit uchun
# mijoz IP'si X-Forwarded-For dan shu son bo'yicha o'ngdan olinadi. Noto'g'ri
# (katta) qiymat mijoz yuborgan soxta IP'ga ishonishga olib keladi.
TRUSTED_PROXY_HOPS="1"

# --- Loglash ---
# Strukturalangan (JSON) log darajasi: trace|debug|info|warn|error|fatal.
# Bo'sh bo'lsa: prod'da "info", dev'da "debug". O'qishga qulay ko'rinish uchun
# dev'da:  npm run dev | npx pino-pretty
LOG_LEVEL=""
