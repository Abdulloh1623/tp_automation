# Integratsion testlar uchun namuna. Nusxa oling: cp .env.test.example .env.test
#
# MUHIM: baza nomida "test" bo'lishi SHART — testlar bazani TOZALAYDI va
# src/test/integration-setup.ts noto'g'ri bazaga ulanishga yo'l qo'ymaydi.
#
# Bazani yaratish:
#   docker exec tp-postgres psql -U tp -d postgres -c "CREATE DATABASE tp_test"
#   DATABASE_URL="postgresql://tp:PAROL@localhost:5433/tp_test?schema=public" npx prisma migrate deploy
DATABASE_URL="postgresql://tp:PAROL@localhost:5433/tp_test?schema=public"
SESSION_SECRET="integration-test-secret-not-used-anywhere-else"
