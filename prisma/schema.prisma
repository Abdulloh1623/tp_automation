// POS CRM — Prisma sxema (SQLite)
// Eslatma: SQLite enum'ni qo'llamaydi, shuning uchun status maydonlari String.
// Ruxsat etilgan qiymatlar src/lib/constants.ts da belgilangan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Global kalit-qiymat sozlamalar (masalan `statsResetAt` — tablo ko'rsatkichlari
// shu sanadan boshlab hisoblanadi; ma'lumot o'chirilmaydi, faqat filtrlanadi).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id              String   @id @default(cuid())
  name            String
  username        String   @unique
  passwordHash    String
  phone           String?
  role            String   @default("OPERATOR") // ADMIN | OPERATOR | INSTALLER
  region          String? // birlamchi viloyat (eski; regions[0])
  regions         String? // usta/xodim qoplaydigan viloyatlar — vergulli ro'yxat (ko'p viloyat)
  isActive        Boolean  @default(true)
  telegramId      String?  @unique // Telegram bot ruxsati/DM uchun
  // Operatorning kunlik lid kvotasi. `null` = AVTOMATIK: dastur bugungi qayta
  // aloqa ro'yxatini faol operatorlarga bo'lib chiqadi (`/sozlamalar` dagi eng
  // kam/eng ko'p chegaralari ichida). Son kiritilsa — o'sha odam uchun qat'iy
  // (yangi xodim, yarim stavka, ta'tilda 0). Bir kunlik qo'shimcha —
  // `DailyLeadGrant.extraCount`.
  dailyLimit      Int?
  shift           String   @default("DAY") // ish smenasi: DAY (kunduzgi) | NIGHT (kechki) — tablo shu bo'yicha filtrlaydi
  sessionVersion  Int      @default(0) // faol sessiya versiyasi — yangi kirish eskisini bekor qiladi (bitta qurilma)
  // Kartaga dostupi bor xodim: karta/QR to'lovlari shu odam(lar) tasdig'idan
  // o'tadi (bot DM'iga tugmalar bilan xabar boradi). Rol emas — belgi, chunki
  // bu huquq rol iyerarxiyasidan mustaqil (kassir ham, boshliq ham bo'lishi mumkin).
  cardVerifier    Boolean  @default(false)
  createdAt       DateTime @default(now())

  assignedClients      Client[]                @relation("AssignedOperator")
  ustaClients          Client[]                @relation("AssignedUsta")
  specialNotes         Client[]                @relation("SpecialNoteAuthor")
  callLogs             CallLog[]               @relation("CallLogOperator")
  editedCallLogs       CallLog[]               @relation("CallLogEditor")
  payments             Payment[]
  tickets              Ticket[]                @relation("TicketOperator")
  ustaTickets          Ticket[]                @relation("TicketUsta")
  staffTickets         Ticket[]                @relation("TicketStaff")
  escalationClients    Client[]                @relation("EscalationStaff")
  dailyGrants          DailyLeadGrant[]
  passwordResets       PasswordResetRequest[]
  notifications        NotificationRecipient[]
  pendingPayments      PendingPayment[]        @relation("PendingPaymentResolver")
  faqEntries           FaqEntry[]              @relation("FaqAuthor")
  cardPaymentsRecorded PendingCardPayment[]    @relation("CardPaymentRecorder")
  cardPaymentsResolved PendingCardPayment[]    @relation("CardPaymentResolver")
}

// FAQ — bilim bazasi. Istalgan xodim (OPERATOR/MANAGER/ADMIN) yangi savol/muammo
// va yechim qo'sha oladi; TAHRIRLASH va O'CHIRISH faqat ADMIN qo'lida (RBAC
// server action'da tekshiriladi). `details` va `solution` — cheklangan markdown
// (qalin, kursiv, havola, rasm/skrinshot); xavfsiz render lib/markdown.tsx da.
model FaqEntry {
  id          String   @id @default(cuid())
  question    String // savol/muammo sarlavhasi (oddiy matn — qidiriladi, akkordeon boshi)
  details     String? // ixtiyoriy muammo tafsiloti (markdown — skrinshot/havola)
  solution    String // yechim (markdown — skrinshot/havola/qalin/kursiv)
  createdById String?
  createdBy   User?    @relation("FaqAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

// Bildirishnoma — admin yozadi, xodimlarga yuboradi.
model Notification {
  id          String   @id @default(cuid())
  title       String
  body        String
  priority    String   @default("NORMAL") // NORMAL | IMPORTANT
  audience    String   @default("ALL") // ALL | OPERATOR | MANAGER (ko'rsatish uchun)
  createdById String?
  createdAt   DateTime @default(now())

  recipients NotificationRecipient[]

  @@index([createdAt])
}

// Har bir qabul qiluvchi uchun yozuv — o'qilgan/o'qilmagan kuzatuvi.
model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

// Parolni tiklash so'rovi — foydalanuvchi yangi parol so'raydi, admin tasdiqlaydi.
model PasswordResetRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newPasswordHash String // tasdiqlangach user.passwordHash ga ko'chiriladi
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note            String? // foydalanuvchi izohi (ixtiyoriy)
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedById    String? // tasdiqlagan/rad etgan admin (id)

  @@index([status])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String // inson o'qiy oladigan amal nomi
  entity    String? // Client | User | Payment | Ticket
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DailyLeadGrant {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime // o'sha kun (00:00, UTC+5)
  extraCount  Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

model Client {
  id              String    @id @default(cuid())
  fullName        String
  restaurantName  String
  region          String?
  phone           String
  contractNumber  String?
  contractDate    DateTime?
  installerName   String?
  monoblokCount   Int       @default(1)
  equipment       String?
  equipmentMode   String    @default("PROGRAM_ONLY") // RENTAL | SOLD | PROGRAM_ONLY
  status          String    @default("ACTIVE") // ACTIVE | INACTIVE | PENDING
  monthlyAmount   Float     @default(0)
  currency        String    @default("USD") // USD | UZS
  nextPaymentDate DateTime?
  debtAmount      Float     @default(0) // joriy qarz qoldig'i (mijozning currency'sida)
  notes           String?
  assignedToId    String?
  assignedTo      User?     @relation("AssignedOperator", fields: [assignedToId], references: [id])

  // Ustaga biriktirish (eskalatsiya/o'rnatish)
  assignedUstaId String?
  assignedUsta   User?   @relation("AssignedUsta", fields: [assignedUstaId], references: [id])
  ustaStatus     String? // USTA_STATUS: ASSIGNED|EN_ROUTE|ARRIVED|DONE|FAILED|REVISIT

  // Maxsus (doimiy) izoh — mijoz nomi yonida qo'ng'iroqcha bilan
  specialNote     String?
  specialNoteById String?
  specialNoteBy   User?     @relation("SpecialNoteAuthor", fields: [specialNoteById], references: [id])
  specialNoteAt   DateTime?

  // Lid workflow (kunlik qo'ng'iroq jarayoni)
  stage           String    @default("NEW") // LEAD_STAGE: NEW|NO_ANSWER|LATER|AWAITING_PAYMENT|FORWARDED|RESOLVED|DEACTIVATED
  pendingStage    String? // bugun yozilgan natija bo'yicha kun-yakuni maqsad bo'lim
  nextContactDate DateTime? // qachon qayta aloqa (kunlik ro'yxat shu bo'yicha)
  lastOutcome     String? // oxirgi yozilgan natija (LEAD_OUTCOME)
  lastContactedAt DateTime? // oxirgi aloqa vaqti
  missedCallCount Int       @default(0) // ketma-ket ko'tarilmagan qo'ng'iroqlar (3+ da avtomatik ustaga)

  // Eskalatsiya mas'uli — admin biriktiradi; usta+mijoz bilan ishlab yakunlaydi
  escalationStaffId String?
  escalationStaff   User?     @relation("EscalationStaff", fields: [escalationStaffId], references: [id])
  escalatedAt       DateTime? // eskalatsiya boshlangan vaqt (3-kunlik SLA hisobi uchun)
  slaNotifiedAt     DateTime? // oxirgi 3-kunlik SLA ogohlantirishi yuborilgan vaqt

  // Biznex integratsiyasi — telefon bo'yicha moslashtirilgan obuna holati
  // (fon skripti `npm run sync-biznex` orqali yangilanadi). null = hali tekshirilmagan.
  biznexStatus    String? // ACTIVE | EXPIRED | INACTIVE | NOT_FOUND
  biznexCheckedAt DateTime? // oxirgi Biznex tekshiruvi vaqti

  // Mijoz "yo'qotilgan" (churn) bo'lgan vaqt — status INACTIVE bo'lganda yoki
  // otkaz/o'chirilgan (REFUSED/DEACTIVATED) bo'lganda yoziladi; qayta faollashsa
  // tozalanadi (null). Moliya (MRR o'sish/churn) tarixiy hisobi shu bo'yicha.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments        Payment[]
  callLogs        CallLog[]
  tickets         Ticket[]
  suggestions     Suggestion[]
  equipmentItems  ClientEquipment[]
  returnRequests  EquipmentReturnRequest[]
  taxConnections  TaxConnection[]
  phones          ClientPhone[]
  pendingPayments PendingPayment[]         @relation("PendingPaymentClient")
  cardPayments    PendingCardPayment[]     @relation("CardPaymentClient")

  @@index([status])
  @@index([nextPaymentDate])
  @@index([assignedToId, stage])
  @@index([assignedToId, nextContactDate])
  @@index([assignedUstaId])
  @@index([escalationStaffId])
  @@index([biznexStatus])
  @@index([deactivatedAt])
}

model ClientPhone {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String // Egasi | Menejer | Kassir | Buxgalter | ...
  number    String
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Payment {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount       Float
  currency     String    @default("USD")
  paidAt       DateTime  @default(now())
  periodStart  DateTime?
  periodEnd    DateTime?
  method       String? // CARD | QR (PAYMENT_METHOD) — to'lov usuli
  receiptNote  String?
  receiptPath  String? // saqlangan chek rasmi yo'li (uploads/receipts/...)
  recordedById String?
  recordedBy   User?     @relation(fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([clientId])
  @@index([paidAt])
}

// Telegram "To'lov cheklari" guruhidan kelgan, hali tasdiqlanmagan chek.
//
// Bot chekni va matnni ushlab shu yerga yozadi; operator /tolovlar sahifasida
// summani kiritib tasdiqlaydi — shundan keyingina haqiqiy Payment yaratiladi.
// Avtomatik yozilmaydi: summa xabar matnida bo'lmaydi (faqat chek rasmida).
model PendingPayment {
  id                String    @id @default(cuid())
  // Telegram xabar identifikatori — dublikat oldini olish kaliti.
  // Bot qayta ishga tushsa yoki xabar qayta kelsa ikkinchi yozuv yaratilmaydi.
  tgChatId          String
  tgMessageId       String
  // Xabarni guruhga yuborgan xodim (ko'rsatish uchun)
  senderName        String?
  // Chek xabari bilan birga kelgan matn (parse qilingan manba)
  rawText           String?
  parsedName        String?
  parsedPhone       String? // oxirgi 9 raqam
  sheetNo           String? // eski Google Sheets tartib raqami — faqat izoh uchun
  // Taxmin qilingan mijoz (telefon aniq mos kelsa). Operator o'zgartirishi mumkin.
  suggestedClientId String?
  suggestedClient   Client?   @relation("PendingPaymentClient", fields: [suggestedClientId], references: [id], onDelete: SetNull)
  // Saqlangan chek fayli (uploads/receipts/... — Payment bilan bir xil joy)
  receiptPath       String?
  receiptMime       String?
  // Manba: TELEGRAM — bot jonli ushlagan; HISTORY — guruh eksportidan bir
  // martalik import. HISTORY yozuvlari billingni SURMAYDI (pastga qarang).
  source            String    @default("TELEGRAM")
  // Chek guruhga tashlangan sana (eksportda xabar sanasi). Tarixiy importda
  // to'lovning haqiqiy sanasi shu bo'ladi — "bugun" emas.
  occurredAt        DateTime?
  // --- OCR natijasi (tesseract, faqat tarixiy import) ---
  ocrText           String?
  suggestedAmount   Float?
  suggestedCurrency String?
  // high — yorliqli summa topildi; low — taxmin; none — topilmadi.
  // Operator UI'da past ishonchlilar ajratib ko'rsatiladi.
  amountConfidence  String?
  // Bir chekda bir necha summa bo'lishi mumkin (masalan Paynet: "To'lov
  // summasi" va "Mijozdan olinadigan" — komissiya tufayli har xil).
  // Operator tanlashi uchun JSON ro'yxat sifatida saqlanadi.
  amountCandidates  String?
  status            String    @default("PENDING") // PENDING | CONFIRMED | REJECTED
  // Tasdiqlangach yaratilgan to'lov
  paymentId         String?
  resolvedById      String?
  resolvedBy        User?     @relation("PendingPaymentResolver", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?
  rejectReason      String?
  receivedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@unique([tgChatId, tgMessageId])
  @@index([status, receivedAt])
}

/// Karta/QR to'lovi — kartaga dostupi bor xodim tasdiqlaguncha kutish navbati.
///
/// MUHIM: bu YOZUV HALI TO'LOV EMAS. Mijozning `nextPaymentDate`i surilmaydi,
/// hisobotlar/analitika bunga qaramaydi. Tasdiqlangach haqiqiy `Payment`
/// yaratiladi (`paymentId` shu yerga yoziladi) va billing o'shanda suriladi.
model PendingCardPayment {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation("CardPaymentClient", fields: [clientId], references: [id], onDelete: Cascade)
  amount       Float
  currency     String    @default("UZS")
  // To'lov qamrovi (kun) — tasdiqlangach shu bo'yicha keyingi sana hisoblanadi
  days         Int       @default(30)
  method       String // CARD | QR (PAYMENT_METHOD)
  paidAt       DateTime  @default(now())
  receiptNote  String?
  // Chek fayli operator yuborganda saqlanadi; tasdiqlangach Payment'ning o'z
  // fayliga ko'chadi va bu nusxa o'chiriladi (rad etilsa ham o'chiriladi).
  receiptPath  String?
  receiptMime  String?
  recordedById String?
  recordedBy   User?     @relation("CardPaymentRecorder", fields: [recordedById], references: [id])
  status       String    @default("PENDING") // PENDING | CONFIRMED | REJECTED
  paymentId    String? // tasdiqlangach yaratilgan to'lov
  resolvedById String?
  resolvedBy   User?     @relation("CardPaymentResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  resolvedVia  String? // TELEGRAM | WEB
  rejectReason String?
  /// Tasdiqlovchilarga yuborilgan xabarlar: [{"chatId":"..","messageId":1}] —
  /// javobdan keyin tugmalarni olib tashlab, natijani yozish uchun.
  tgMessages   String?
  notifiedAt   DateTime?
  /// Oxirgi eslatma vaqti (javobsiz qolgan so'rovlar uchun kunlik ogohlantirish)
  remindedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([clientId])
}

model CallLog {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calledAt         DateTime  @default(now())
  result           String // NO_ANSWER | PHONE_OFF | BUSY | TALKED | SMS_SENT | TELEGRAM_SENT | RESOLVED
  note             String?
  operatorId       String?
  operator         User?     @relation("CallLogOperator", fields: [operatorId], references: [id])
  nextFollowUpDate DateTime?
  createdAt        DateTime  @default(now())
  // Tahrir kuzatuvi — izoh keyin o'zgartirilsa kim va qachon (audit'ga qo'shimcha,
  // kartada ko'rinadi). Birinchi yozgan = operator/calledAt; tahrirlagan = editedBy/editedAt.
  editedAt         DateTime?
  editedById       String?
  editedBy         User?     @relation("CallLogEditor", fields: [editedById], references: [id])

  @@index([clientId])
  @@index([calledAt])
  @@index([nextFollowUpDate])
}

model Ticket {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  type            String    @default("TECHNICAL") // TECHNICAL | FEATURE | PAYMENT | TAX
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  priority        String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  assignedToId    String?
  assignedTo      User?     @relation("TicketOperator", fields: [assignedToId], references: [id])
  // Muammoni hal qiluvchi biriktiruv — polimorf: joyida (usta) yoki online (xodim)
  assigneeType    String? // USTA (joyida hal etish) | XODIM (online hal etish)
  // Integrator (usta) — boshliq muammoni biriktiradi; joyida hal etadi
  assignedUstaId  String?
  assignedUsta    User?     @relation("TicketUsta", fields: [assignedUstaId], references: [id])
  // Xodim (operator/menejer/admin) — muammoni online hal etish uchun biriktiriladi
  assignedStaffId String?
  assignedStaff   User?     @relation("TicketStaff", fields: [assignedStaffId], references: [id])
  // Biriktirishda boshliq yozgan izoh — mas'ul xodim / usta uchun (biriktiruv bilan birga tozalanadi)
  staffNote       String? // mas'ul xodimga izoh
  ustaNote        String? // ustaga izoh
  resolutionNote  String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  slaNotifiedAt   DateTime? // oxirgi 3-kunlik SLA ogohlantirishi yuborilgan vaqt

  @@index([clientId])
  @@index([status])
  @@index([assignedUstaId])
  @@index([assignedStaffId])
}

// Mijoz taklifi — muammo emas, dastur/jarayon yuzasidan taklif. Operator lid
// natijasida "Taklif" tanlaganda yaratiladi; admin/menejerdagi "Takliflar"
// bo'limiga tushadi. 1 oy hal qilinmasa har kuni bildirishnoma (runSlaCheck).
model Suggestion {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  body         String
  status       String    @default("OPEN") // OPEN | RESOLVED
  createdById  String? // qayd etgan operator (User.id — Notification kabi, relatsiyasiz)
  resolvedById String? // hal qilgan admin/menejer (User.id)
  resolvedAt   DateTime?
  notifiedAt   DateTime? // oxirgi 1-oylik SLA bildirishnomasi yuborilgan vaqt
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([clientId])
}

// --- Ombor (inventar) ---

model EquipmentType {
  id          String  @id @default(cuid())
  name        String  @unique // Printer | Monoblok | WiFi router
  rentalPrice Float   @default(0) // ijara (oylik) narxi
  salePrice   Float   @default(0) // sotuv narxi
  minStock    Int     @default(0) // kam zaxira chegarasi (ogohlantirish uchun)
  isActive    Boolean @default(true) // faolsizlantirilgan tur formalarda ko'rinmaydi

  stock           InventoryStock[]
  clientEquipment ClientEquipment[]
}

model InventoryStock {
  id              String        @id @default(cuid())
  locationType    String // WAREHOUSE | USTA
  locationId      String // "WAREHOUSE" yoki ustaId
  equipmentTypeId String
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
  quantity        Int           @default(0)

  @@unique([locationType, locationId, equipmentTypeId])
  @@index([locationType, locationId])
}

model ClientEquipment {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  equipmentTypeId String
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
  quantity        Int           @default(0)
  ownership       String // RENTAL | SOLD
  unitPrice       Float? // biriktirishda kelishilgan birlik narxi; null = EquipmentType standart narxi

  @@unique([clientId, equipmentTypeId, ownership])
  @@index([clientId])
}

model EquipmentMovement {
  id              String   @id @default(cuid())
  equipmentTypeId String
  quantity        Int
  fromType        String? // WAREHOUSE | USTA | CLIENT | BRAK
  fromId          String?
  toType          String? // WAREHOUSE | USTA | CLIENT | BRAK
  toId            String?
  reason          String?
  note            String? // ombor→usta va →brak da majburiy
  byUserId        String?
  // Hujjatli topshirish (Chiqarib yuborish / Qabul qilish hujjati) — faqat
  // ombor→usta taqsimotida ishlatiladi. Boshqa harakatlarda null.
  documentStatus  String? // PENDING_DOC | NOT_REQUIRED | UPLOADED | APPROVED
  signedDocUrl    String? // imzolangan hujjat (uploads/handouts/...) — pdf/jpg
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([documentStatus])
}

model EquipmentReturnRequest {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  byUserId   String? // arizani bergan operator
  note       String?
  status     String    @default("PENDING") // PENDING | APPROVED | IN_PROGRESS | REJECTED | DONE
  ustaId     String? // tasdiqlangach biriktirilgan usta
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
}

// Soliqqa ulash arizasi — operator mijozni soliqqa ulash uchun yuboradi,
// admin/menejer ko'radi va ulangach "Ulandi" deb belgilaydi.
model TaxConnection {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  certificateNo   String // Firma guvohnomasi raqami
  certificatePath String? // Guvohnoma skani (pdf/jpeg/word)
  directorName    String // Firma rahbarining ismi va familiyasi
  directorPhone   String // Firma rahbari telefon raqami
  documentPath    String? // Firma kadastri yoki ijara shartnomasi (pdf/jpeg/word)
  geoLink         String // Firma geolokatsiyasi linki
  note            String?
  status          String    @default("PENDING") // PENDING | CONNECTED
  byUserId        String? // yuborgan operator
  connectedById   String? // "Ulandi" deb belgilagan boshliq
  connectedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
}
