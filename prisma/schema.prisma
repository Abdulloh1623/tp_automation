// POS CRM — Prisma sxema (SQLite)
// Eslatma: SQLite enum'ni qo'llamaydi, shuning uchun status maydonlari String.
// Ruxsat etilgan qiymatlar src/lib/constants.ts da belgilangan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Global kalit-qiymat sozlamalar (masalan `statsResetAt` — tablo ko'rsatkichlari
// shu sanadan boshlab hisoblanadi; ma'lumot o'chirilmaydi, faqat filtrlanadi).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id              String   @id @default(cuid())
  name            String
  username        String   @unique
  passwordHash    String
  phone           String?
  role            String   @default("OPERATOR") // ADMIN | OPERATOR | INSTALLER
  region          String? // birlamchi viloyat (eski; regions[0])
  regions         String? // usta/xodim qoplaydigan viloyatlar — vergulli ro'yxat (ko'p viloyat)
  isActive        Boolean  @default(true)
  telegramId      String?  @unique // Telegram bot ruxsati/DM uchun
  dailyLeadTarget Int      @default(20) // kunlik lid soni (ko'rsatkich maqsadi)
  dailyLimit      Int      @default(20) // kunlik avtomatik biriktirish chegarasi (kvota)
  shift           String   @default("DAY") // ish smenasi: DAY (kunduzgi) | NIGHT (kechki) — tablo shu bo'yicha filtrlaydi
  sessionVersion  Int      @default(0) // faol sessiya versiyasi — yangi kirish eskisini bekor qiladi (bitta qurilma)
  createdAt       DateTime @default(now())

  assignedClients Client[]         @relation("AssignedOperator")
  ustaClients     Client[]         @relation("AssignedUsta")
  specialNotes    Client[]         @relation("SpecialNoteAuthor")
  callLogs        CallLog[]
  payments        Payment[]
  tickets         Ticket[]               @relation("TicketOperator")
  ustaTickets     Ticket[]               @relation("TicketUsta")
  staffTickets    Ticket[]               @relation("TicketStaff")
  escalationClients Client[]             @relation("EscalationStaff")
  dailyGrants     DailyLeadGrant[]
  passwordResets  PasswordResetRequest[]
  notifications   NotificationRecipient[]
}

// Bildirishnoma — admin yozadi, xodimlarga yuboradi.
model Notification {
  id          String   @id @default(cuid())
  title       String
  body        String
  priority    String   @default("NORMAL") // NORMAL | IMPORTANT
  audience    String   @default("ALL") // ALL | OPERATOR | MANAGER (ko'rsatish uchun)
  createdById String?
  createdAt   DateTime @default(now())

  recipients NotificationRecipient[]

  @@index([createdAt])
}

// Har bir qabul qiluvchi uchun yozuv — o'qilgan/o'qilmagan kuzatuvi.
model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

// Parolni tiklash so'rovi — foydalanuvchi yangi parol so'raydi, admin tasdiqlaydi.
model PasswordResetRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newPasswordHash String // tasdiqlangach user.passwordHash ga ko'chiriladi
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note            String? // foydalanuvchi izohi (ixtiyoriy)
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedById    String? // tasdiqlagan/rad etgan admin (id)

  @@index([status])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String // inson o'qiy oladigan amal nomi
  entity    String? // Client | User | Payment | Ticket
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DailyLeadGrant {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime // o'sha kun (00:00, UTC+5)
  extraCount  Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

model Client {
  id              String    @id @default(cuid())
  fullName        String
  restaurantName  String
  region          String?
  phone           String
  contractNumber  String?
  contractDate    DateTime?
  installerName   String?
  monoblokCount   Int       @default(1)
  equipment       String?
  equipmentMode   String    @default("PROGRAM_ONLY") // RENTAL | SOLD | PROGRAM_ONLY
  status          String    @default("ACTIVE") // ACTIVE | INACTIVE | PENDING
  monthlyAmount   Float     @default(0)
  currency        String    @default("USD") // USD | UZS
  nextPaymentDate DateTime?
  debtAmount      Float     @default(0) // joriy qarz qoldig'i (mijozning currency'sida)
  notes           String?
  assignedToId    String?
  assignedTo      User?     @relation("AssignedOperator", fields: [assignedToId], references: [id])

  // Ustaga biriktirish (eskalatsiya/o'rnatish)
  assignedUstaId String?
  assignedUsta   User?   @relation("AssignedUsta", fields: [assignedUstaId], references: [id])
  ustaStatus     String? // USTA_STATUS: ASSIGNED|EN_ROUTE|ARRIVED|DONE|FAILED|REVISIT

  // Maxsus (doimiy) izoh — mijoz nomi yonida qo'ng'iroqcha bilan
  specialNote     String?
  specialNoteById String?
  specialNoteBy   User?     @relation("SpecialNoteAuthor", fields: [specialNoteById], references: [id])
  specialNoteAt   DateTime?

  // Lid workflow (kunlik qo'ng'iroq jarayoni)
  stage           String    @default("NEW") // LEAD_STAGE: NEW|NO_ANSWER|LATER|AWAITING_PAYMENT|FORWARDED|RESOLVED|DEACTIVATED
  pendingStage    String? // bugun yozilgan natija bo'yicha kun-yakuni maqsad bo'lim
  nextContactDate DateTime? // qachon qayta aloqa (kunlik ro'yxat shu bo'yicha)
  lastOutcome     String? // oxirgi yozilgan natija (LEAD_OUTCOME)
  lastContactedAt DateTime? // oxirgi aloqa vaqti
  missedCallCount Int       @default(0) // ketma-ket ko'tarilmagan qo'ng'iroqlar (3+ da avtomatik ustaga)

  // Eskalatsiya mas'uli — admin biriktiradi; usta+mijoz bilan ishlab yakunlaydi
  escalationStaffId String?
  escalationStaff   User?     @relation("EscalationStaff", fields: [escalationStaffId], references: [id])
  escalatedAt       DateTime? // eskalatsiya boshlangan vaqt (3-kunlik SLA hisobi uchun)
  slaNotifiedAt     DateTime? // oxirgi 3-kunlik SLA ogohlantirishi yuborilgan vaqt

  // Biznex integratsiyasi — telefon bo'yicha moslashtirilgan obuna holati
  // (fon skripti `npm run sync-biznex` orqali yangilanadi). null = hali tekshirilmagan.
  biznexStatus    String? // ACTIVE | EXPIRED | INACTIVE | NOT_FOUND
  biznexCheckedAt DateTime? // oxirgi Biznex tekshiruvi vaqti

  // Mijoz "yo'qotilgan" (churn) bo'lgan vaqt — status INACTIVE bo'lganda yoki
  // otkaz/o'chirilgan (REFUSED/DEACTIVATED) bo'lganda yoziladi; qayta faollashsa
  // tozalanadi (null). Moliya (MRR o'sish/churn) tarixiy hisobi shu bo'yicha.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments       Payment[]
  callLogs       CallLog[]
  tickets        Ticket[]
  suggestions    Suggestion[]
  equipmentItems ClientEquipment[]
  returnRequests EquipmentReturnRequest[]
  taxConnections TaxConnection[]
  phones         ClientPhone[]

  @@index([status])
  @@index([nextPaymentDate])
  @@index([assignedToId, stage])
  @@index([assignedToId, nextContactDate])
  @@index([assignedUstaId])
  @@index([escalationStaffId])
  @@index([biznexStatus])
  @@index([deactivatedAt])
}

model ClientPhone {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String // Egasi | Menejer | Kassir | Buxgalter | ...
  number    String
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Payment {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount       Float
  currency     String    @default("USD")
  paidAt       DateTime  @default(now())
  periodStart  DateTime?
  periodEnd    DateTime?
  method       String? // CARD | QR (PAYMENT_METHOD) — to'lov usuli
  receiptNote  String?
  receiptPath  String? // saqlangan chek rasmi yo'li (uploads/receipts/...)
  recordedById String?
  recordedBy   User?     @relation(fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([clientId])
  @@index([paidAt])
}

model CallLog {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calledAt         DateTime  @default(now())
  result           String // NO_ANSWER | PHONE_OFF | BUSY | TALKED | SMS_SENT | TELEGRAM_SENT | RESOLVED
  note             String?
  operatorId       String?
  operator         User?     @relation(fields: [operatorId], references: [id])
  nextFollowUpDate DateTime?
  createdAt        DateTime  @default(now())

  @@index([clientId])
  @@index([calledAt])
  @@index([nextFollowUpDate])
}

model Ticket {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  type           String    @default("TECHNICAL") // TECHNICAL | FEATURE | PAYMENT | TAX
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  assignedToId   String?
  assignedTo     User?     @relation("TicketOperator", fields: [assignedToId], references: [id])
  // Muammoni hal qiluvchi biriktiruv — polimorf: joyida (usta) yoki online (xodim)
  assigneeType   String? // USTA (joyida hal etish) | XODIM (online hal etish)
  // Integrator (usta) — boshliq muammoni biriktiradi; joyida hal etadi
  assignedUstaId String?
  assignedUsta   User?     @relation("TicketUsta", fields: [assignedUstaId], references: [id])
  // Xodim (operator/menejer/admin) — muammoni online hal etish uchun biriktiriladi
  assignedStaffId String?
  assignedStaff  User?     @relation("TicketStaff", fields: [assignedStaffId], references: [id])
  // Biriktirishda boshliq yozgan izoh — mas'ul xodim / usta uchun (biriktiruv bilan birga tozalanadi)
  staffNote      String? // mas'ul xodimga izoh
  ustaNote       String? // ustaga izoh
  resolutionNote String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  slaNotifiedAt  DateTime? // oxirgi 3-kunlik SLA ogohlantirishi yuborilgan vaqt

  @@index([clientId])
  @@index([status])
  @@index([assignedUstaId])
  @@index([assignedStaffId])
}

// Mijoz taklifi — muammo emas, dastur/jarayon yuzasidan taklif. Operator lid
// natijasida "Taklif" tanlaganda yaratiladi; admin/menejerdagi "Takliflar"
// bo'limiga tushadi. 1 oy hal qilinmasa har kuni bildirishnoma (runSlaCheck).
model Suggestion {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  body         String
  status       String    @default("OPEN") // OPEN | RESOLVED
  createdById  String? // qayd etgan operator (User.id — Notification kabi, relatsiyasiz)
  resolvedById String? // hal qilgan admin/menejer (User.id)
  resolvedAt   DateTime?
  notifiedAt   DateTime? // oxirgi 1-oylik SLA bildirishnomasi yuborilgan vaqt
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([clientId])
}

// --- Ombor (inventar) ---

model EquipmentType {
  id          String  @id @default(cuid())
  name        String  @unique // Printer | Monoblok | WiFi router
  rentalPrice Float   @default(0) // ijara (oylik) narxi
  salePrice   Float   @default(0) // sotuv narxi
  minStock    Int     @default(0) // kam zaxira chegarasi (ogohlantirish uchun)
  isActive    Boolean @default(true) // faolsizlantirilgan tur formalarda ko'rinmaydi

  stock           InventoryStock[]
  clientEquipment ClientEquipment[]
}

model InventoryStock {
  id              String        @id @default(cuid())
  locationType    String // WAREHOUSE | USTA
  locationId      String // "WAREHOUSE" yoki ustaId
  equipmentTypeId String
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
  quantity        Int           @default(0)

  @@unique([locationType, locationId, equipmentTypeId])
  @@index([locationType, locationId])
}

model ClientEquipment {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  equipmentTypeId String
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
  quantity        Int           @default(0)
  ownership       String // RENTAL | SOLD
  unitPrice       Float? // biriktirishda kelishilgan birlik narxi; null = EquipmentType standart narxi

  @@unique([clientId, equipmentTypeId, ownership])
  @@index([clientId])
}

model EquipmentMovement {
  id              String   @id @default(cuid())
  equipmentTypeId String
  quantity        Int
  fromType        String? // WAREHOUSE | USTA | CLIENT | BRAK
  fromId          String?
  toType          String? // WAREHOUSE | USTA | CLIENT | BRAK
  toId            String?
  reason          String?
  note            String? // ombor→usta va →brak da majburiy
  byUserId        String?
  // Hujjatli topshirish (Chiqarib yuborish / Qabul qilish hujjati) — faqat
  // ombor→usta taqsimotida ishlatiladi. Boshqa harakatlarda null.
  documentStatus  String? // PENDING_DOC | NOT_REQUIRED | UPLOADED | APPROVED
  signedDocUrl    String? // imzolangan hujjat (uploads/handouts/...) — pdf/jpg
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([documentStatus])
}

model EquipmentReturnRequest {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  byUserId   String? // arizani bergan operator
  note       String?
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED | DONE
  ustaId     String? // tasdiqlangach biriktirilgan usta
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
}

// Soliqqa ulash arizasi — operator mijozni soliqqa ulash uchun yuboradi,
// admin/menejer ko'radi va ulangach "Ulandi" deb belgilaydi.
model TaxConnection {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  certificateNo   String // Firma guvohnomasi raqami
  certificatePath String? // Guvohnoma skani (pdf/jpeg/word)
  directorName    String // Firma rahbarining ismi va familiyasi
  directorPhone   String // Firma rahbari telefon raqami
  documentPath    String? // Firma kadastri yoki ijara shartnomasi (pdf/jpeg/word)
  geoLink         String // Firma geolokatsiyasi linki
  note            String?
  status          String    @default("PENDING") // PENDING | CONNECTED
  byUserId        String? // yuborgan operator
  connectedById   String? // "Ulandi" deb belgilagan boshliq
  connectedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
}
